# ================= Qbao .gitignore =================
# 策略：GitHub 只管理 app/（前端）、server/（后端）、docs/、tools/ 四部分；
# 一切隐私/本地内容统一放 local/（密钥、用户数据、日志、历史快照）。

# ---- Node 依赖 ----
node_modules/
server/node_modules/
# ChatECNU 托管依赖环境（dependency_install 项目级安装目录）
.chatecnu/

# ---- 环境变量与密钥（任何位置都不上传）----
.env
.env.*
!.env.example
*.pem
*.key
*.lnk
*.bundle

# ---- 本地专用目录：隐私数据/密钥/日志/版本快照，永不上传 GitHub ----
local/

# ---- 运行时上传文件（含用户数据，生产环境实时生成）----
uploads/
server/uploads/

# ---- 日志 ----
*.log

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- 临时文件 ----
.tmp/

# ---- 桌面安装器误装进仓库时的产物（软件应装到独立目录）----
/Qbao.exe
/Uninstall*.exe
/resources/
/locales/
/*.pak
/*.dll
/*.dat
/LICENSE.electron.txt
/LICENSES.chromium.html

# ---- tools/：默认忽略其中的一次性脚本，仅保留说明 ----
tools/*
!tools/README.md
# P0.3: e2e 回归探针入库（tools/e2e），运行产物 out/ 不入库
!tools/e2e/
!tools/e2e/**
tools/e2e/out/

# ---- 桌面端（Electron）----
desktop/node_modules/
desktop/release/
desktop/config.local.json
desktop/dist/
# ---- 本地 AI 端到端测试脚本（含敏感信息，永不提交）----
e2e-ai-scenarios/

# ---- 前端构建产物与本地密钥（T1 整改）----
app/dist/
app/.tmp/
local/keys/

# ---- 前端构建产物与本地密钥（T1 整改）----
app/dist/
app/.tmp/
local/keys/
downloads/
.chatecnu-work/
