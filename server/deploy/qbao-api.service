[Unit]
Description=Qbao API (Node.js Express)
Documentation=https://github.com/Paraso42/Qbao
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
# T22: 非 root 运行 — 部署用户 qbao（upload 目录属主须为 qbao，见 deploy/README.md）
User=qbao
Group=qbao
# 部署前将 {PROD_ROOT} 替换为实际部署根（真实值仅存 local/ENV.md）
WorkingDirectory={PROD_ROOT}/server
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
TimeoutStopSec=15
Environment=NODE_ENV=production

# 基础加固（T22）：禁止提权、收紧进程环境
NoNewPrivileges=true
PrivateTmp=true

# 日志统一到 journald：
#   journalctl -u qbao-api -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
