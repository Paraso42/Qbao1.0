# Qbao 后端环境变量示例 — 复制为 server/.env 并填写实际值
# 前端默认请求同源 /api/v1，由 nginx 反代到本服务

PORT=3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=qbao
PGUSER=qbao
PGPASSWORD=your_db_password

# JWT 签名密钥 — 务必改为随机长字符串，例如: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# 管理员用户名（逗号分隔，拥有反馈管理权限）
# T3：库中尚无管理员时，仅用户名在此列表中的首个注册用户会自动成为 admin；
# 已有管理员后的新注册用户一律为普通用户。已有部署可用 scripts/bootstrap_admin.js 提升。
ADMIN_USERNAMES=admin

# AUTO_ADMIN=1 时注册即管理员 —— 仅限内测环境（L1 beta）开启（内测服全员管理员模式）；生产严禁设置
AUTO_ADMIN=0

# AI Provider API Key — 按需填写，留空则该 Provider 不可用
ECNU_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
