<view class="page theme-{{equippedBackground}}">
  <view wx:if="{{debugError}}" class="debug-error">启动失败：{{debugError}}</view>
  <view class="topbar">
    <view>
      <text class="eyebrow">GALTON LIGHTS</text>
      <text class="title">高尔顿灯阵</text>
    </view>
    <view class="balance">
      <text class="balance-label">弹珠余额</text>
      <view class="balance-line">
        <text class="balance-value">{{marbles}}</text>
        <text class="diamond-value">◆ {{diamonds}}</text>
        <view class="shop-button" bindtap="openShop">商城</view>
      </view>
    </view>
  </view>

  <view class="status-row">
    <view class="status-item">
      <text class="status-label">本局投入</text>
      <text class="status-value">{{wager}} 颗</text>
    </view>
    <view class="status-item status-center">
      <text class="status-label">倍率</text>
      <text class="status-value accent">{{stage == 'setup' ? '--' : '×' + multiplier}}</text>
    </view>
    <view class="status-item status-right">
      <text class="status-label">亮灯</text>
      <text class="status-value">{{stage == 'setup' ? '流水预览' : (isRandomizing ? '扫描中' : litCount + ' / ' + slotCount)}}</text>
    </view>
  </view>

  <view class="board-shell">
    <canvas wx:if="{{!showShop}}" type="2d" id="gameCanvas" class="game-canvas"></canvas>
  </view>
  <page-container show="{{showShop}}" position="bottom" round="true" overlay="true" z-index="9999" close-on-slide-down="false">
    <view class="shop-panel">
      <view class="shop-head">
        <view>
          <text class="shop-title">弹珠商城</text>
          <text class="shop-balance">{{marbles}} 颗弹珠 · ◆ {{diamonds}} 钻石</text>
        </view>
        <view class="shop-close" bindtap="closeShop">×</view>
      </view>
      <scroll-view scroll-y class="shop-list">
        <text class="shop-section-title">弹珠外观</text>
        <view wx:for="{{shopItems}}" wx:key="id" class="shop-item {{item.equipped ? 'equipped' : ''}}">
          <view class="preview-wrap">
            <view wx:if="{{item.trail}}" class="trail-preview" style="background: {{item.trail}};"></view>
            <view class="skin-preview" style="background: {{item.color}}; border-color: {{item.edge}}; box-shadow: 0 0 22rpx {{item.trail || item.color}};"></view>
          </view>
          <view class="skin-info">
            <text class="skin-name">{{item.name}}</text>
            <text class="skin-meta">{{item.trail ? '动态尾焰弹珠' : '经典球面弹珠'}}</text>
          </view>
          <view class="skin-action {{item.equipped ? 'active' : ''}}" data-id="{{item.id}}" bindtap="buyOrEquipSkin">
            {{item.equipped ? '使用中' : (item.owned ? '装备' : (item.currency == 'diamond' ? '◆ ' : '') + item.price + (item.currency == 'diamond' ? '' : ' 颗'))}}
          </view>
        </view>
        <text class="shop-section-title background-title">背景主题</text>
        <view wx:for="{{backgroundItems}}" wx:key="id" wx:for-item="background" class="shop-item {{background.equipped ? 'equipped' : ''}}">
          <view class="background-preview" style="background: {{background.board}}; border-color: {{background.line}};"></view>
          <view class="skin-info"><text class="skin-name">{{background.name}}</text><text class="skin-meta">棋盘与场景主题</text></view>
          <view class="skin-action {{background.equipped ? 'active' : ''}}" data-id="{{background.id}}" bindtap="buyOrEquipBackground">{{background.equipped ? '使用中' : (background.owned ? '使用' : '◆ ' + background.price)}}</view>
        </view>
      </scroll-view>
    </view>
  </page-container>

  <view wx:if="{{showResult}}" class="result-mask">
    <view class="result-dialog {{resultType}}">
      <view class="result-mark">{{resultType == 'win' ? '✓' : '×'}}</view>
      <text class="result-title">{{resultType == 'win' ? '恭喜你' : '很遗憾'}}</text>
      <text class="result-copy">{{resultType == 'win' ? '获得 ' + resultAmount + ' 颗珠子' : '再试一次吧'}}</text>
      <button class="result-button" bindtap="closeResult">确定</button>
    </view>
  </view>

  <view class="controls">
    <view wx:if="{{stage == 'ready' || stage == 'running'}}" class="power-row">
      <text class="control-label">弹簧发力</text>
      <view class="power-control">
        <view class="power-meter">
          <view class="power-fill" style="{{'width:' + power + '%'}}"></view>
        </view>
        <text class="power-value">{{power}}%</text>
      </view>
    </view>

    <view class="stake-row">
      <text class="control-label">单局弹珠</text>
      <view class="stepper">
        <view class="icon-btn {{stage != 'setup' || wager == 10 ? 'disabled' : ''}}" bindtap="decreaseStake">−</view>
        <text class="stake-value">{{wager}}</text>
        <view class="icon-btn {{stage != 'setup' || wager >= 100 ? 'disabled' : ''}}" bindtap="increaseStake">＋</view>
      </view>
    </view>

    <button wx:if="{{stage == 'setup'}}" class="confirm-btn" bindtap="confirmStake" disabled="{{marbles >= wager ? false : true}}">投入 {{wager}} 颗弹珠</button>

    <view wx:elif="{{stage == 'randomizing'}}" class="randomizing-btn">
      <view class="scan-dot"></view><text>正在随机倍率</text><view class="scan-dot"></view>
    </view>

    <view wx:else class="plunger-btn {{isRunning ? 'disabled' : ''}} {{isCharging ? 'charging' : ''}}"
      catchtouchstart="startCharging" catchtouchend="releaseCharging" catchtouchcancel="releaseCharging">
      <view class="plunger-icon"><view class="spring-mini"></view><view class="red-handle"></view></view>
      <text>{{isRunning ? '弹珠运行中' : (isCharging ? '松开发射' : '按住红色拉杆蓄力')}}</text>
    </view>
  </view>
</view>
